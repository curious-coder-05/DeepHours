  function drawCanvasFrame() {
    const canvas = $('#pipCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const W = 480, H = 270;

    const m = getTimerMetrics();
    const isRunning = m && m.status === 'running';
    const isPaused = m && m.status === 'paused';
    const sub = m ? m.subject : getSubject();
