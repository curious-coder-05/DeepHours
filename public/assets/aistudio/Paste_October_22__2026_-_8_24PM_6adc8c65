function pauseTimer() {
  const t = S.activeTimer;
  if (!t || t.status === 'paused') return;
  t.status = 'paused';
  t.pauseStartTs = Date.now();
  t.pauseCount = (t.pauseCount || 0) + 1;
  t.slicePauseCount = (t.slicePauseCount || 0) + 1;

