// Saves the current active subject slice to S.sessions
function commitCurrentSlice(now = Date.now(), reflection = null) {
  const t = S.activeTimer;
  if (!t || t.phase === 'break') return null;

  const curPause = (t.status === 'paused' && t.pauseStartTs) ? Math.max(0, now - t.pauseStartTs) : 0;
  const slicePausedMs = (t.slicePausedMs || 0) + curPause;
  const sliceActiveMs = Math.max(0, now - t.sliceStartTs - slicePausedMs);

  // Only record slices with at least 5 seconds of study
  if (sliceActiveMs < 5000) return null;

  const totalPaused = (t.pausedDurationMs || 0) + curPause;
  const totalActive = Math.max(0, now - t.startTs - totalPaused);
  const overtimeMs = (t.mode !== 'stopwatch' && t.targetMs && totalActive > t.targetMs)
    ? Math.min(sliceActiveMs, totalActive - t.targetMs)
    : 0;
  const denom = sliceActiveMs + slicePausedMs;
  const purity = denom > 0 ? Math.round((sliceActiveMs / denom) * 100) : 100;

  const entry = {
    id: uid('ses'),
    subjectId: t.subjectId,
    dayKey: logicalKey(t.sliceStartTs),
    startTs: t.sliceStartTs,
    endTs: now,
    activeMs: sliceActiveMs,
    pausedMs: slicePausedMs,
    pauseCount: t.slicePauseCount || 0,
    overtimeMs,
    purity,
    mode: t.mode,
    rating: reflection?.rating || 5,
    note: reflection?.note || '',
    updatedAt: now
  };

  S.sessions.push(entry);
  S.bonus = (S.bonus || 0) + Math.max(5, Math.round(sliceActiveMs / 60000));
  syncStudyHabits(entry.dayKey);
  return entry;
}

// Priority 2.3: Mid-Session Subject Switching
function switchSubjectMidSession(newSubjectId) {
  const t = S.activeTimer;
