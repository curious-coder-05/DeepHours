  if (purEl) purEl.textContent = `${m.purity}%`;
  const todaySubEl = $('#liveTodaySub');
  if (todaySubEl) todaySubEl.textContent = fmtHMShort(getTodaySubjectMs(t.subjectId));

  syncStudyHabits();
  FloatingPiP.renderTick();
}

