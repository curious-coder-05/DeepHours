document.addEventListener('submit', e => {
  const f = new FormData(e.target);
  const id = e.target.id;

  if (id === 'hf') {
    e.preventDefault();
    const hid = e.target.dataset.id;
    const days = [0, 1, 2, 3, 4, 5, 6].filter(i => f.get('d' + i));
    const name = String(f.get('name')).trim();
    if (!name) return;
    const subId = f.get('subjectId') || '';
    const o = {
      name,
      e: String(f.get('e')).trim() || '✨',
      c: f.get('c'),
      sch: f.get('sch'),
      days: days.length ? days : [0, 1, 2, 3, 4, 5, 6],
      n: Math.min(7, Math.max(1, +f.get('n') || 3)),
      tn: Math.min(999, Math.max(1, +f.get('tn') || 1)),
      tu: subId ? 'min' : String(f.get('tu')).trim(),
      rem: f.get('rem') || '',
      subjectId: subId
    };
    if (hid) Object.assign(S.habits.find(h => h.id === hid), o, { u: Date.now() });
    else S.habits.push(mk(o));
    S.ob = 1;
    syncStudyHabits();
    save();
    $('#dlg').close();
    R();
  } else if (id === 'subForm') {
    e.preventDefault();
    const sid = e.target.dataset.id;
    const o = {
      name: String(f.get('name')).trim() || 'Subject',
      e: String(f.get('e')).trim() || '📚',
      color: f.get('color') || '#6366f1',
      dailyGoalMins: +f.get('dailyGoalMins') || 120
    };
    if (sid) Object.assign(S.subjects.find(x => x.id === sid), o);
    else S.subjects.push({ id: uid('sub'), arch: 0, todos: [], ...o });
    save();
    $('#dlg').close();
    R();
  } else if (id === 'todoForm') {
    e.preventDefault();
    const sub = getSubject(e.target.dataset.sub);
    const txt = String(f.get('txt')).trim();
    if (txt && sub) {
      sub.todos.push({ id: uid('td'), text: txt, done: false });
      save();
      R();
    }
  } else if (id === 'reflectForm') {
    e.preventDefault();
    const rating = +f.get('rating') || 5;
    const note = String(f.get('note') || '').trim();
    commitCurrentSlice(Date.now(), { rating, note });
    S.activeTimer = null;
    updateSoundscape();
    syncWakeLock();
    FloatingPiP.close();
    beep('win');
    boom();
    save();
    $('#dlg').close();
    R();
  } else if (id === 'manualSesForm') {
    e.preventDefault();
    const sesId = e.target.dataset.id;
    const dayKey = f.get('dayKey') || sel;
    const [sh, sm] = String(f.get('startTime')).split(':').map(Number);
    const [eh, em] = String(f.get('endTime')).split(':').map(Number);
    const baseD = parse(dayKey);
    const startTs = new Date(baseD.getFullYear(), baseD.getMonth(), baseD.getDate(), sh, sm).getTime();
    let endTs = new Date(baseD.getFullYear(), baseD.getMonth(), baseD.getDate(), eh, em).getTime();
    if (endTs <= startTs) endTs += 86400000; // Crossed midnight
    const pausedMs = Math.max(0, (+f.get('pauseMins') || 0) * 60000);
    const activeMs = Math.max(60000, (endTs - startTs) - pausedMs);
    const purity = Math.round((activeMs / (activeMs + pausedMs)) * 100);

    const payload = {
      id: sesId || uid('ses'),
      subjectId: f.get('subjectId'),
      dayKey,
      startTs,
      endTs,
      activeMs,
      pausedMs,
      pauseCount: pausedMs > 0 ? 1 : 0,
      overtimeMs: 0,
      purity,
      mode: 'manual',
      rating: Math.min(5, Math.max(1, +f.get('rating') || 5)),
      note: String(f.get('note') || '').trim(),
      updatedAt: Date.now()
    };

    if (sesId) {
      const idx = S.sessions.findIndex(x => x.id === sesId);
      if (idx > -1) S.sessions[idx] = payload;
    } else {
      S.sessions.push(payload);
    }
    syncStudyHabits(dayKey);
    save();
    $('#dlg').close();
    toast('Study session saved');
    R();
  } else if (id === 'cfgTimerForm') {
    e.preventDefault();
    S.set.pomoWork = Math.max(5, +f.get('pomoWork') || 25);
    S.set.pomoBreak = Math.max(1, +f.get('pomoBreak') || 5);
    S.set.countdownMins = Math.max(5, +f.get('countdownMins') || 45);
    save();
    $('#dlg').close();
    R();
  } else if (id === 'ddayForm') {
    e.preventDefault();
    const did = e.target.dataset.id;
    const o = {
      title: String(f.get('title')).trim(),
      date: f.get('date'),
      e: String(f.get('e')).trim() || '🎓',
      color: f.get('color') || '#10b981'
    };
    if (did) Object.assign(S.ddays.find(x => x.id === did), o);
    else S.ddays.push({ id: uid('dd'), ...o });
    save();
    $('#dlg').close();
    R();
  }
});

document.addEventListener('click', e => {
  // Star rating selector inside Reflection Modal
  const starBtn = e.target.closest('[data-star]');
  if (starBtn) {
    const val = +starBtn.dataset.star;
    const inp = $('#refRating');
    if (inp) inp.value = val;
    $$('#starPicker button').forEach(b => b.classList.toggle('lit', +b.dataset.star <= val));
    return;
  }

  const b = e.target.closest('[data-a]');
  if (!b) return;
  const a = b.dataset.a, id = b.dataset.id;

  if (a === 'tab') { tab = b.dataset.t; R(); scrollTo(0, 0); }
  else if (a === 'tog') tog(id);
  else if (a === 'inc') { e.stopPropagation(); setV(id, sel, +b.dataset.d); }
  else if (a === 'skip') { e.stopPropagation(); skp(id); }
  else if (a === 'cat') { cat = b.dataset.c; R(); }
  else if (a === 'goto') { sel = b.dataset.k; R(); }
  else if (a === 'mood') { S.mood[sel] = S.mood[sel] == +b.dataset.v ? 0 : +b.dataset.v; save(); R(); }
  else if (a === 'starter') { S.habits.push(mk(STARTERS[+b.dataset.i])); S.ob = 1; syncStudyHabits(); save(); R(); }
  else if (a === 'new') edit();
  else if (a === 'edit') { e.stopPropagation(); edit(id); }
  else if (a === 'close') $('#dlg').close();
  else if (a === 'arch') { const h = S.habits.find(x => x.id === id); h.arch = h.arch ? 0 : 1; h.u = Date.now(); save(); $('#dlg').close(); R(); }
  else if (a === 'del') { const j = snap(); S.habits = S.habits.filter(x => x.id !== id); delete S.log[id]; (S.del ??= []).push(id); save(); $('#dlg').close(); R(); toast('Habit deleted', undo(j)); }
  // Subject & Study Timer Actions
  else if (a === 'new-sub') editSubjectModal();
  else if (a === 'edit-sub') editSubjectModal(id);
  else if (a === 'quick-start') { tab = 'focus'; startTimer(id, 'pomo'); }
  else if (a === 'pick-sub') {
    if (S.activeTimer) switchSubjectMidSession(id);
    else {
      // Move selected subject to front of picker by starting or storing default
      const idx = S.subjects.findIndex(x => x.id === id);
      if (idx > 0) {
        const [item] = S.subjects.splice(idx, 1);
        S.subjects.unshift(item);
        save();
      }
      R();
    }
  }
  else if (a === 'set-mode') {
    if (!S.activeTimer) {
      startTimer(S.subjects[0].id, b.dataset.m);
      pauseTimer();
      S.activeTimer.pauseCount = 0;
      S.activeTimer.slicePauseCount = 0;
      save();
      R();
    }
  }
  else if (a === 't-start') startTimer(id, 'pomo');
  else if (a === 't-toggle') toggleTimerPause();
  else if (a === 't-phase') togglePomoPhase();
  else if (a === 't-stop') stopTimerAndReflect();
  else if (a === 'discard-ses') { S.activeTimer = null; updateSoundscape(); syncWakeLock(); FloatingPiP.close(); save(); $('#dlg').close(); R(); }
  else if (a === 'pip-open') FloatingPiP.togglePiP();
  else if (a === 'desk-toggle') { deskMode = !deskMode; syncWakeLock(); R(); }
  else if (a === 'cfg-timer') openTimerConfigModal();
  else if (a === 'soundscape') { ensureAudioEngine(); S.set.soundscape = b.dataset.v; updateSoundscape(); save(); R(); }
  else if (a === 'tog-todo') {
    const sub = getSubject(b.dataset.sub);
    const td = sub?.todos?.find(x => x.id === id);
    if (td) { td.done = !td.done; save(); R(); }
  }
  else if (a === 'del-todo') {
    const sub = getSubject(b.dataset.sub);
    if (sub) { sub.todos = sub.todos.filter(x => x.id !== id); save(); R(); }
  }
  else if (a === 'manual-ses') openManualSessionModal();
  else if (a === 'edit-ses') openManualSessionModal(id);
  else if (a === 'del-ses') {
    S.sessions = S.sessions.filter(x => x.id !== id);
    syncStudyHabits(sel);
    save();
    $('#dlg').close();
    R();
  }
  else if (a === 'new-dday') openDDayModal();
  else if (a === 'edit-dday') openDDayModal(id);
  else if (a === 'del-dday') { S.ddays = S.ddays.filter(x => x.id !== id); save(); $('#dlg').close(); R(); }
  else if (a === 'brush') { planBrush = id; R(); }
  else if (a === 'ac') { S.set.ac = b.dataset.c; save(); theme(); R(); }
  else if (a === 'inst') { dp.prompt(); dp = null; R(); }
  else if (a === 'exj') { S.exp = Date.now(); save(); dl(`pulsehabit-backup-${today()}.json`, JSON.stringify(S, null, 2), 'application/json'); R(); }
  else if (a === 'exc') {
    const r = ['type,date,name_or_subject,minutes_or_value,purity_pct,note'];
    S.sessions.forEach(s => {
      const sub = getSubject(s.subjectId);
      r.push(`study_session,${s.dayKey},"${sub.name.replace(/"/g, '""')}",${Math.round(s.activeMs / 60000)},${s.purity || 100},"${(s.note || '').replace(/"/g, '""')}"`);
    });
    S.habits.forEach(h => Object.entries(S.log[h.id] || {}).sort().forEach(([k, e]) => {
      r.push(`habit,${k},"${h.name.replace(/"/g, '""')}",${e.v},100,""`);
    }));
    dl(`pulsehabit-export-${today()}.csv`, r.join('\n'), 'text/csv');
  }
  else if (a === 'reset') {
    if (confirm('Erase all study sessions, habits, and plans on this device? Export a JSON backup first.')) {
      S = def(); save(); theme(); R();
    }
  }
});

