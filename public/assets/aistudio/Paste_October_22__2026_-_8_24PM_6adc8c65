let timerLoopId = 0;

function getSubject(id) {
  return S.subjects.find(x => x.id === id) || S.subjects[0] || DEFAULT_SUBJECTS[0];
}

// Pure timestamp-based calculation: zero background drift even if mobile browser throttles tab
function getTimerMetrics(now = Date.now()) {
  const t = S?.activeTimer;
  if (!t) return null;

  const curPauseMs = (t.status === 'paused' && t.pauseStartTs) ? Math.max(0, now - t.pauseStartTs) : 0;
  const totalPausedMs = (t.pausedDurationMs || 0) + curPauseMs;
  const slicePausedMs = (t.slicePausedMs || 0) + curPauseMs;

  const totalActiveMs = Math.max(0, now - t.startTs - totalPausedMs);
  const sliceActiveMs = Math.max(0, now - t.sliceStartTs - slicePausedMs);

  let displayMs = totalActiveMs;
  let overtimeMs = 0;
  let progressPct = 0;

  if (t.mode === 'stopwatch') {
    displayMs = totalActiveMs;
    progressPct = ((totalActiveMs / 1000) % 3600) / 36;
  } else {
    const target = t.targetMs || 1500000;
    if (totalActiveMs <= target) {
      displayMs = target - totalActiveMs;
      progressPct = Math.min(100, (totalActiveMs / target) * 100);
    } else {
      // Count-Up Overtime (Flow State)
      displayMs = 0;
      overtimeMs = totalActiveMs - target;
      progressPct = 100;
    }
  }

  const denom = totalActiveMs + totalPausedMs;
  const purity = denom > 0 ? Math.round((totalActiveMs / denom) * 100) : 100;

  return {
    status: t.status,
    mode: t.mode,
    phase: t.phase || 'work',
    subject: getSubject(t.subjectId),
    totalActiveMs,
    totalPausedMs,
    sliceActiveMs,
    slicePausedMs,
    displayMs,
    overtimeMs,
    progressPct,
    purity,
    pauseCount: t.pauseCount || 0
  };
}

function getTodaySubjectMs(subId, k = today()) {
  let ms = S.sessions
    .filter(s => s.dayKey === k && (subId === 'any' || s.subjectId === subId))
    .reduce((acc, s) => acc + (s.activeMs || 0), 0);

  if (S.activeTimer && k === today()) {
    const m = getTimerMetrics();
    if (m && m.phase !== 'break' && (subId === 'any' || S.activeTimer.subjectId === subId)) {
      ms += m.sliceActiveMs;
    }
  }
  return ms;
}

// Auto-complete study habits linked to subjects
function syncStudyHabits(k = today()) {
  let changed = false;
  S.habits.forEach(h => {
    if (!h.subjectId) return;
    const mins = Math.floor(getTodaySubjectMs(h.subjectId, k) / 60000);
    const L = S.log[h.id] ??= {};
    const prev = L[k]?.v || 0;
    if (mins !== prev) {
      L[k] = { v: mins, s: L[k]?.s || 0 };
      changed = true;
    }
  });
  if (changed) save();
}

function startTimer(subjectId, mode, customTargetMins) {
  ensureAudioEngine();
  const sub = subjectId || S.subjects.find(x => !x.arch)?.id || S.subjects[0].id;
  const m = mode || 'pomo';
  const targetMins = m === 'pomo' ? (S.set.pomoWork || 25) : m === 'countdown' ? (customTargetMins || S.set.countdownMins || 45) : 0;

  const now = Date.now();
  S.activeTimer = {
    status: 'running',
    mode: m,
    phase: 'work',
    subjectId: sub,
    startTs: now,
    sliceStartTs: now,
    pauseStartTs: null,
    pausedDurationMs: 0,
    slicePausedMs: 0,
    pauseCount: 0,
    slicePauseCount: 0,
    targetMs: targetMins * 60000,
    chimeFired: false
