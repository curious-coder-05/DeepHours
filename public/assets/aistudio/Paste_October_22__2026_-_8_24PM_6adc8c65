  updateSoundscape();
  syncWakeLock();
  FloatingPiP.syncState();
  save();
  R();
}

function resumeTimer() {
  const t = S.activeTimer;
  if (!t || t.status !== 'paused') return;
  ensureAudioEngine();
  const now = Date.now();
  const deltaPause = t.pauseStartTs ? Math.max(0, now - t.pauseStartTs) : 0;
  t.pausedDurationMs = (t.pausedDurationMs || 0) + deltaPause;
  t.slicePausedMs = (t.slicePausedMs || 0) + deltaPause;
  t.pauseStartTs = null;
  t.status = 'running';

  beep('ok');
  updateSoundscape();
  syncWakeLock();
  ensureTimerLoop();
  FloatingPiP.syncState();
  save();
  R();
}

function toggleTimerPause() {
