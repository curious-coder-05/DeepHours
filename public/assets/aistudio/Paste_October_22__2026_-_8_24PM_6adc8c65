  const now = Date.now();
  const saved = commitCurrentSlice(now, { rating: 5, note: 'Auto-logged on subject switch' });

  // Reset slice counters for the new Subject while preserving overall session timer
  t.subjectId = newSubjectId;
  t.sliceStartTs = now;
  t.slicePausedMs = 0;
  t.slicePauseCount = 0;
  if (t.status === 'paused') t.pauseStartTs = now;

  const newSub = getSubject(newSubjectId);
  toast(saved ? `Saved ${fmtHMShort(saved.activeMs)} · Switched to ${newSub.e} ${newSub.name}` : `Switched to ${newSub.e} ${newSub.name}`);
  FloatingPiP.syncState();
  save();
