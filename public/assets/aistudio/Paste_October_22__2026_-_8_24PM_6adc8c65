  const m = getTimerMetrics();
  if (t.status === 'running') pauseTimer();

  // If less than 5 seconds or in break, discard cleanly
  if (!m || m.sliceActiveMs < 5000 || t.phase === 'break') {
    S.activeTimer = null;
