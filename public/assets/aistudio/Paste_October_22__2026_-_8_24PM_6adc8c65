let audioCtx = null;
let mediaStreamDest = null;
let silentKeepAliveGain = null;
let noiseNode = null;
let noiseGain = null;

function ensureAudioEngine() {
  if (!audioCtx) {
    const AC = window.AudioContext || window.webkitAudioContext;
    audioCtx = new AC();
  }
  if (audioCtx.state === 'suspended') {
    audioCtx.resume().catch(() => {});
  }
  if (!mediaStreamDest) {
    mediaStreamDest = audioCtx.createMediaStreamDestination();
    // Crucial for Android Chrome PiP: continuous 0.001 gain audio signal
    // so Android OS treats the <video> stream as an active media session with Play/Pause controls
    const osc = audioCtx.createOscillator();
    silentKeepAliveGain = audioCtx.createGain();
    silentKeepAliveGain.gain.value = 0.001;
    osc.frequency.value = 60;
    osc.connect(silentKeepAliveGain);
    silentKeepAliveGain.connect(mediaStreamDest);
    osc.start();
  }
  return audioCtx;
}

function beep(type) {
  if (navigator.vibrate) navigator.vibrate(type === 'win' ? [25, 45, 35] : type === 'chime' ? [40, 60, 80] : 12);
  if (!S?.set?.snd) return;
  try {
    const ctx = ensureAudioEngine();
    const n = ctx.currentTime;
    if (type === 'chime') {
      // Gentle two-note harmonic bell chime for Flow State Overtime transition
      [528, 792].forEach((freq, idx) => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'sine';
        o.frequency.setValueAtTime(freq, n + idx * 0.18);
        g.gain.setValueAtTime(0.16, n + idx * 0.18);
        g.gain.exponentialRampToValueAtTime(0.0008, n + idx * 0.18 + 1.4);
        o.connect(g);
        g.connect(ctx.destination);
        if (mediaStreamDest) g.connect(mediaStreamDest);
        o.start(n + idx * 0.18);
        o.stop(n + idx * 0.18 + 1.45);
      });
      return;
    }
    const o = ctx.createOscillator();
    const g = ctx.createGain();
    o.connect(g);
    g.connect(ctx.destination);
    o.frequency.setValueAtTime(type === 'no' ? 300 : type === 'win' ? 880 : 560, n);
    o.frequency.exponentialRampToValueAtTime(type === 'no' ? 220 : type === 'win' ? 1320 : 840, n + 0.12);
    g.gain.setValueAtTime(0.11, n);
    g.gain.exponentialRampToValueAtTime(0.001, n + 0.15);
    o.start(n);
    o.stop(n + 0.16);
  } catch {}
}

// Procedural Soundscape Generator (Brown Noise, Pink Noise, Rain)
function updateSoundscape() {
  const mode = S?.set?.soundscape || 'off';
  const isTimerRunning = S?.activeTimer?.status === 'running';

  if (mode === 'off' || !isTimerRunning) {
    if (noiseNode) {
      try { noiseNode.stop(); noiseNode.disconnect(); } catch {}
      noiseNode = null;
    }
    return;
  }

  try {
    const ctx = ensureAudioEngine();
    if (noiseNode) {
      try { noiseNode.stop(); noiseNode.disconnect(); } catch {}
      noiseNode = null;
    }

    const bufferSize = ctx.sampleRate * 4; // 4-second seamless loop buffer
    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
    const out = buffer.getChannelData(0);

    if (mode === 'brown') {
      let lastOut = 0.0;
      for (let i = 0; i < bufferSize; i++) {
        const white = Math.random() * 2 - 1;
        out[i] = (lastOut + (0.02 * white)) / 1.02;
        lastOut = out[i];
        out[i] *= 3.2;
      }
    } else if (mode === 'pink') {
      let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;
      for (let i = 0; i < bufferSize; i++) {
        const white = Math.random() * 2 - 1;
        b0 = 0.99886 * b0 + white * 0.0555179;
        b1 = 0.99332 * b1 + white * 0.0750759;
        b2 = 0.96900 * b2 + white * 0.1538520;
        b3 = 0.86650 * b3 + white * 0.3104856;
        b4 = 0.55000 * b4 + white * 0.5329522;
        b5 = -0.7616 * b5 - white * 0.0168980;
        out[i] = (b0 + b1 + b2 + b3 + b4 + b5 + b6 + white * 0.5362) * 0.04;
        b6 = white * 0.115926;
      }
    } else if (mode === 'rain') {
      // Procedural Rain: filtered pink/white wash + subtle stochastic patters
      let b0 = 0, b1 = 0, b2 = 0;
      for (let i = 0; i < bufferSize; i++) {
        const white = Math.random() * 2 - 1;
        b0 = 0.98 * b0 + white * 0.08;
        b1 = 0.92 * b1 + white * 0.15;
        const drop = Math.random() > 0.9985 ? (Math.random() * 0.65) : 0;
        b2 = 0.75 * b2 + drop;
        out[i] = (b0 + b1 * 0.6 + b2) * 0.18;
      }
    }

    const src = ctx.createBufferSource();
    src.buffer = buffer;
    src.loop = true;

    const filter = ctx.createBiquadFilter();
    filter.type = mode === 'rain' ? 'bandpass' : 'lowpass';
    filter.frequency.value = mode === 'brown' ? 420 : mode === 'pink' ? 1200 : 1450;
    if (mode === 'rain') filter.Q.value = 0.7;

    noiseGain = ctx.createGain();
    noiseGain.gain.value = Math.max(0.02, Math.min(1, S.set.soundVol ?? 0.35));

    src.connect(filter);
    filter.connect(noiseGain);
    noiseGain.connect(ctx.destination);
    if (mediaStreamDest) noiseGain.connect(mediaStreamDest);

    src.start();
    noiseNode = src;
  } catch {}
}

