}

function setV(id, k, d) {
  const h = S.habits.find(x => x.id === id);
  if (!h) return;
  const L = S.log[id] ??= {}, e = L[k] ??= { v: 0, s: 0 }, was = done(h, k);
  e.s = 0;
  e.v = Math.max(0, e.v + d);
  if (!e.v) delete L[k];
  if (k < h.created) h.created = k;
  const now = done(h, k);
  beep(now ? 'ok' : 'no');
  if (now && !was && dueOn(k).length && dueOn(k).every(x => done(x, k))) {
    beep('win');
    boom();
    toast('Perfect day 🎉');
  }
  save();
  R();
}

function tog(id) {
  const h = S.habits.find(x => x.id === id), e = ent(h, sel);
  setV(id, sel, done(h, sel) ? -e.v : h.tn - (e?.v || 0));
}

function skp(id) {
  const L = S.log[id] ??= {}, e = L[sel] ??= { v: 0, s: 0 };
  e.s = e.s ? 0 : 1;
  if (e.s) e.v = 0;
  if (!e.s && !e.v) delete L[sel];
  save();
  R();
}

