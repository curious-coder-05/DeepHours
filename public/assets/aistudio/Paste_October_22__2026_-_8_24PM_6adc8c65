// Priority 3.1: YPT-Style 24-Hour 10-Minute Grid Timeline
function vPlanner() {
  if (!planBrush) planBrush = S.subjects.find(x => !x.arch)?.id || S.subjects[0].id;
  const resetHr = S.set.dayResetHour ?? 4;
  const hours = [...Array(24)].map((_, i) => (resetHr + i) % 24);
  const dayPlan = S.plans[sel] || {};
  const daySessions = S.sessions.filter(s => s.dayKey === sel);

  // Compute Actual 10-minute slot fills from logged session timestamps + active live timer
  const actualSlots = {};
  const paintSessionIntoSlots = (startTs, endTs, subjectId) => {
    const sub = getSubject(subjectId);
    // Step in 1-minute increments to map accurately into 10-min cells
    for (let ts = startTs; ts < endTs; ts += 60000) {
      const d = new Date(ts);
      const slotIdx = d.getHours() * 6 + Math.floor(d.getMinutes() / 10);
      if (!actualSlots[slotIdx]) actualSlots[slotIdx] = { sub, mins: 0 };
      actualSlots[slotIdx].mins = Math.min(10, actualSlots[slotIdx].mins + 1);
    }
  };

  daySessions.forEach(s => paintSessionIntoSlots(s.startTs, s.endTs, s.subjectId));
  if (S.activeTimer && sel === today() && S.activeTimer.phase !== 'break') {
    paintSessionIntoSlots(S.activeTimer.sliceStartTs, Date.now(), S.activeTimer.subjectId);
  }

  const plannedCount = Object.keys(dayPlan).length;
  const actualMins = Math.round(getTodaySubjectMs('any', sel) / 60000);

  return `
  <div class="row sp">
    <div>
      <h2>24h 10-Minute Grid (${sel})</h2>
      <small>Planned: ${fmtHMShort(plannedCount * 600000)} vs Actual: ${fmtHMShort(actualMins * 60000)}</small>
    </div>
    <button class="s" data-a="manual-ses">+ Log Session</button>
  </div>

  <!-- Subject Paint Brush Selector -->
  <div class="card" style="padding:12px">
    <small style="display:block;margin-bottom:6px">Tap or drag on <b>Planned</b> cells to paint 10-min blocks:</small>
    <div class="sub-legend">
      ${S.subjects.filter(s => !s.arch).map(s => `
        <button class="sub-chip ${planBrush === s.id ? 'active' : ''}" style="--sc:${esc(s.color)}" data-a="brush" data-id="${s.id}">
          <i class="dot" style="--sc:${esc(s.color)}"></i>${esc(s.e)} ${esc(s.name)}
        </button>
      `).join('')}
      <button class="sub-chip ${planBrush === 'erase' ? 'active' : ''}" data-a="brush" data-id="erase">🧹 Eraser</button>
    </div>
  </div>

  <div class="card" style="padding:12px">
    <div class="grid-wrap" style="margin-bottom:6px">
      <div class="grid-hdr">Hr</div>
      <div class="grid-hdr">Planned (Tap/Drag)</div>
      <div class="grid-hdr">Actual (Auto-Logged)</div>
    </div>
    <div class="grid-wrap" id="tenMinGrid">
      <div class="hr-col">
        ${hours.map(h => `<div class="hr-lbl">${pad(h)}:00</div>`).join('')}
      </div>
      <div class="slots-col">
        ${hours.map(h => `<div class="hr-row">
          ${[0, 1, 2, 3, 4, 5].map(idx => {
            const slot = h * 6 + idx;
            const pSubId = dayPlan[slot];
            const pSub = pSubId ? getSubject(pSubId) : null;
            return `<div class="slot" data-plan-slot="${slot}" title="${pad(h)}:${idx}0 Planned: ${pSub ? esc(pSub.name) : 'Empty'}">
              ${pSub ? `<i style="background:${esc(pSub.color)};opacity:.85"></i>` : ''}
            </div>`;
          }).join('')}
        </div>`).join('')}
      </div>
      <div class="slots-col">
        ${hours.map(h => `<div class="hr-row">
          ${[0, 1, 2, 3, 4, 5].map(idx => {
            const slot = h * 6 + idx;
            const act = actualSlots[slot];
            const fillPct = act ? Math.min(100, Math.max(25, act.mins * 10)) : 0;
            return `<div class="slot" title="${pad(h)}:${idx}0 Actual: ${act ? esc(act.sub.name) + ' (' + act.mins + 'm)' : '0m'}">
              ${act ? `<i style="background:${esc(act.sub.color)};width:${fillPct}%"></i>` : ''}
            </div>`;
          }).join('')}
        </div>`).join('')}
      </div>
    </div>
  </div>`;
}

// Priority 4: Deep Study Analytics (Milestone Heatmap, Circadian Chart, First Start/Last End Averages)
function vStats() {
  const t = today();

  // 1. Milestone Color-Depth Heatmap (84 days / 12 weeks: 0h, <2h, 2-4h, 4-6h, 6-8h, 8h+)
  const s0 = wkS(addD(t, -77));
  const hmCells = [];
  for (let i = 0; i < 84; i++) {
    const k = addD(s0, i);
    if (k > t) {
      hmCells.push('<i style="opacity:.18"></i>');
      continue;
    }
    const hrs = getTodaySubjectMs('any', k) / 3600000;
    const lvlClass = hrs <= 0 ? 'hm-l0' : hrs < 2 ? 'hm-l1' : hrs < 4 ? 'hm-l2' : hrs < 6 ? 'hm-l3' : hrs < 8 ? 'hm-l4' : 'hm-l5';
    hmCells.push(`<i class="${lvlClass}" title="${k}: ${hrs.toFixed(1)}h studied"></i>`);
  }

  // 2. Circadian Hourly Bar Chart (00:00 - 23:59)
  const hrBuckets = new Array(24).fill(0);
  S.sessions.forEach(s => {
    for (let ts = s.startTs; ts < s.endTs; ts += 300000) { // 5-min samples
      const h = new Date(ts).getHours();
      hrBuckets[h] += 5;
    }
  });
  const maxHrMins = Math.max(30, ...hrBuckets);
  const peakHr = hrBuckets.indexOf(Math.max(...hrBuckets));

  // 3. First Start & Last End Time Averages
  const byDay = {};
  S.sessions.forEach(s => {
    (byDay[s.dayKey] ??= []).push(s);
  });
  let startMinsSum = 0, endMinsSum = 0, dayCount = 0;
  Object.values(byDay).forEach(list => {
    if (!list.length) return;
    dayCount++;
    const earliest = Math.min(...list.map(s => s.startTs));
    const latest = Math.max(...list.map(s => s.endTs));
    const dStart = new Date(earliest), dEnd = new Date(latest);
    startMinsSum += dStart.getHours() * 60 + dStart.getMinutes();
    endMinsSum += dEnd.getHours() * 60 + dEnd.getMinutes();
  });

  const fmtMinsOfDay = m => `${pad(Math.floor(m / 60))}:${pad(Math.round(m % 60))}`;
  const avgStartStr = dayCount ? fmtMinsOfDay(startMinsSum / dayCount) : '--:--';
  const avgEndStr = dayCount ? fmtMinsOfDay(endMinsSum / dayCount) : '--:--';
  const totalHrsAllTime = (S.sessions.reduce((a, s) => a + (s.activeMs || 0), 0) / 3600000).toFixed(1);
  const globalPurity = S.sessions.length ? Math.round(S.sessions.reduce((a, s) => a + (s.purity || 100), 0) / S.sessions.length) : 100;

  const x = xp(), L = lvl(x), nx = Math.pow(L, 2) * 60, pv = Math.pow(L - 1, 2) * 60;

  return `
  <h2>Deep Study & Habit Analytics</h2>
  <div class="stat-mini" style="grid-template-columns:repeat(4,1fr);margin-bottom:10px">
    <div class="stat-box"><small>Total Hours</small><b class="mono">${totalHrsAllTime}h</b></div>
    <div class="stat-box"><small>Avg Start</small><b class="mono">${avgStartStr}</b></div>
    <div class="stat-box"><small>Avg Wrap-up</small><b class="mono">${avgEndStr}</b></div>
    <div class="stat-box"><small>Avg Purity</small><b class="mono">${globalPurity}%</b></div>
  </div>

  <div class="card">
    <div class="row sp">
      <h3>12-Week Study Depth Heatmap</h3>
      <small>0h · &lt;2h · 2-4h · 4-6h · 6-8h · 8h+</small>
    </div>
    <div class="hm" style="margin-top:10px">${hmCells.join('')}</div>
    <div class="row" style="justify-content:flex-end;gap:5px;margin-top:8px;font-size:11px;color:var(--mu)">
      <span>0h</span><i class="hm-l0" style="width:12px;height:12px;border-radius:3px"></i>
      <span>&lt;2h</span><i class="hm-l1" style="width:12px;height:12px;border-radius:3px"></i>
      <span>4h</span><i class="hm-l2" style="width:12px;height:12px;border-radius:3px"></i>
      <span>6h</span><i class="hm-l3" style="width:12px;height:12px;border-radius:3px"></i>
      <span>8h+</span><i class="hm-l5" style="width:12px;height:12px;border-radius:3px"></i>
    </div>
  </div>

  <div class="card">
    <div class="row sp">
      <h3>Circadian Focus Rhythm (00:00–23:59)</h3>
      <small>Peak Hour: <b style="color:var(--em)">${pad(peakHr)}:00</b></small>
    </div>
    <div class="circ-bars">
      ${hrBuckets.map((mins, h) => {
        const pctH = Math.round((mins / maxHrMins) * 100);
        return `<div title="${pad(h)}:00 - ${fmtHMShort(mins * 60000)}">
          <i style="height:${Math.max(3, pctH * 0.8)}px"></i>
          <span>${h % 3 === 0 ? pad(h) : ''}</span>
        </div>`;
      }).join('')}
    </div>
  </div>

  <div class="card">
    <h3>Subject Breakdown</h3>
    ${S.subjects.map(sub => {
      const ms = S.sessions.filter(s => s.subjectId === sub.id).reduce((a, s) => a + (s.activeMs || 0), 0);
      return `<div class="row sp" style="padding:6px 0;border-bottom:1px solid var(--bd)">
        <span><i class="dot" style="--sc:${esc(sub.color)}"></i> ${esc(sub.e)} ${esc(sub.name)}</span>
        <b class="mono">${fmtHMShort(ms)}</b>
      </div>`;
    }).join('')}
  </div>

  <div class="card">
    <h3>Level ${L} · ${x} XP</h3>
    <div style="height:8px;background:var(--c2);border-radius:9px;overflow:hidden;margin:6px 0">
      <div style="height:100%;width:${Math.round((x - pv) / (nx - pv) * 100)}%;background:var(--ac)"></div>
    </div>
    <small>${nx - x} XP to level ${L + 1}</small>
    <div style="margin-top:8px">${badges().map(([n, o]) => `<span class="pill" style="margin:2px;opacity:${o ? 1 : .35}">${n}</span>`).join('')}</div>
  </div>

  <h2>Habit Streaks</h2>
  ${live().map(h => {
    const s = streak(h);
    return `<div class="card"><div class="row sp"><b>${esc(h.e)} ${esc(h.name)}</b><small>${total(h)} check-ins</small></div><small>🔥 ${s.cur} now · best ${s.best} · 7d ${rate(h, 7)}% · 30d ${rate(h, 30)}%</small></div>`;
  }).join('') || '<div class="card mu">No habits yet.</div>'}`;
}

