  function setupMediaSessionHandlers() {
    if (!('mediaSession' in navigator)) return;
    const m = getTimerMetrics();
    const sub = m ? m.subject : getSubject();

    navigator.mediaSession.metadata = new MediaMetadata({
      title: `${sub.e} ${sub.name} (${m ? fmtHMS(m.totalActiveMs) : '00:00:00'})`,
      artist: m?.status === 'paused' ? 'PAUSED · PulseHabit Study Logger' : 'STUDYING · PulseHabit Study Logger',
      album: `Today Total: ${fmtHMShort(getTodaySubjectMs('any'))}`
    });

    navigator.mediaSession.setActionHandler('play', () => {
      if (!S.activeTimer) startTimer(sub.id, 'pomo');
      else if (S.activeTimer.status === 'paused') resumeTimer();
    });

    navigator.mediaSession.setActionHandler('pause', () => {
      if (S.activeTimer && S.activeTimer.status === 'running') pauseTimer();
    });

    navigator.mediaSession.setActionHandler('stop', () => {
      if (S.activeTimer) stopTimerAndReflect();
    });
  }

  async function initVideoStream() {
    const video = $('#pipVideo');
    const canvas = $('#pipCanvas');
    if (!video || !canvas) return null;

    ensureAudioEngine();
    drawCanvasFrame();

    if (!videoStreamReady) {
      const canvasStream = canvas.captureStream(15);
      const combinedTracks = [
        ...canvasStream.getVideoTracks(),
        ...(mediaStreamDest ? mediaStreamDest.stream.getAudioTracks() : [])
      ];
      const combinedStream = new MediaStream(combinedTracks);
      video.srcObject = combinedStream;
      // Crucial Android Chrome requirement: DO NOT set muted attribute once 0.001 gain node is active
      video.muted = false;
      video.removeAttribute('muted');
      video.volume = 1.0;

      video.addEventListener('pause', () => {
        if (syncGuard) return;
        // If native Android PiP Pause button was tapped, pause study timer immediately
        if (S.activeTimer && S.activeTimer.status === 'running') {
          syncGuard = true;
          pauseTimer();
          syncGuard = false;
        }
      });

      video.addEventListener('play', () => {
        if (syncGuard) return;
        // If native Android PiP Play button was tapped, resume study timer immediately
        if (!S.activeTimer) {
          syncGuard = true;
          startTimer();
          syncGuard = false;
        } else if (S.activeTimer.status === 'paused') {
          syncGuard = true;
          resumeTimer();
          syncGuard = false;
        }
      });

      videoStreamReady = true;
    }

    setupMediaSessionHandlers();
    try {
      await video.play();
    } catch {}
    return video;
  }

  async function openDocumentPiP() {
    if (!('documentPictureInPicture' in window)) return false;
    try {
      docPipWin = await window.documentPictureInPicture.requestWindow({ width: 260, height: 130 });
      // Copy stylesheets from main document
      [...document.styleSheets].forEach(ss => {
        try {
          const cssRules = [...ss.cssRules].map(r => r.cssText).join('');
          const style = docPipWin.document.createElement('style');
          style.textContent = cssRules;
          docPipWin.document.head.appendChild(style);
        } catch {
          if (ss.href) {
            const link = docPipWin.document.createElement('link');
            link.rel = 'stylesheet';
            link.href = ss.href;
            docPipWin.document.head.appendChild(link);
          }
        }
      });

      docPipWin.document.body.className = 'pip-body';
      renderDocPiP();

      docPipWin.document.body.addEventListener('click', e => {
        const b = e.target.closest('[data-pip-act]');
        if (!b) return;
        const act = b.dataset.pipAct;
        if (act === 'toggle') {
          if (!S.activeTimer) startTimer();
          else toggleTimerPause();
        } else if (act === 'stop') {
          stopTimerAndReflect();
          docPipWin.close();
        }
      });

      docPipWin.addEventListener('pagehide', () => { docPipWin = null; });
      return true;
    } catch {
      return false;
    }
  }

  function renderDocPiP() {
    if (!docPipWin || docPipWin.closed) return;
    const m = getTimerMetrics();
    const sub = m ? m.subject : getSubject();
    const isPaused = m?.status === 'paused';
    const isRun = m?.status === 'running';

    docPipWin.document.body.style.setProperty('--pip-bd', isPaused ? '#f59e0b' : '#10b981');
    docPipWin.document.body.innerHTML = `
      <div class="pip-top">
        <span style="display:flex;align-items:center;gap:5px">
          <i class="dot" style="--sc:${esc(sub.color)}"></i>
          ${esc(sub.e)} ${esc(sub.name.slice(0, 14))}
        </span>
        <span style="color:${isPaused ? '#fbbf24' : '#34d399'}">
          ${m?.overtimeMs > 0 ? `+${fmtMS(m.overtimeMs)}` : isPaused ? 'PAUSED' : isRun ? `${m.purity}%` : 'IDLE'}
        </span>
      </div>
      <div class="pip-clock">${m ? fmtHMS(m.overtimeMs > 0 ? m.totalActiveMs : m.displayMs) : '00:00:00'}</div>
      <div class="pip-actions">
        <button data-pip-act="toggle" style="background:${isRun ? '#f59e0b' : '#10b981'};color:#052e16">
          ${isRun ? '⏸ Pause' : isPaused ? '▶ Resume' : '▶ Start'}
        </button>
        ${m ? `<button data-pip-act="stop" style="background:#334155;color:#fca5a5">⏹ Stop</button>` : ''}
      </div>
    `;
  }

  async function togglePiP(forceMode) {
    // Ensure a timer is running or initialized when launching lecture companion
    if (!S.activeTimer) {
      startTimer();
    }

    if (docPipWin && !docPipWin.closed) {
      docPipWin.close();
      docPipWin = null;
      return;
    }
    if (document.pictureInPictureElement) {
      await document.exitPictureInPicture().catch(() => {});
      return;
    }

    const pref = forceMode || S?.set?.pipPref || 'video';
    const isAndroid = /Android/i.test(navigator.userAgent);

    // On Android PWA or when 'video' mode is selected, prioritize Canvas+Audio <video> PiP
    if (pref === 'doc' && !isAndroid && 'documentPictureInPicture' in window) {
      const ok = await openDocumentPiP();
      if (ok) return;
    }

    try {
      const video = await initVideoStream();
      if (video && video.requestPictureInPicture) {
        await video.requestPictureInPicture();
        toast('Floating PiP active · Switch to your lecture app');
        return;
      }
    } catch {}

    // Fallback to Document PiP if video PiP failed
    if ('documentPictureInPicture' in window) {
      const ok = await openDocumentPiP();
      if (ok) return;
    }

    toast('PiP is not supported by this browser view');
  }

  function syncState() {
    drawCanvasFrame();
    renderDocPiP();
    setupMediaSessionHandlers();

    const video = $('#pipVideo');
    if (video && videoStreamReady) {
      const isRun = S.activeTimer?.status === 'running';
      if ('mediaSession' in navigator) {
        navigator.mediaSession.playbackState = isRun ? 'playing' : 'paused';
      }
      // Wait 1 animation frame so the "PAUSED" amber badge frame is flushed to the video stream before pausing <video>
      requestAnimationFrame(() => {
        syncGuard = true;
        if (isRun && video.paused) {
          video.play().catch(() => {}).finally(() => { syncGuard = false; });
        } else if (!isRun && !video.paused && document.pictureInPictureElement === video) {
          video.pause();
          syncGuard = false;
        } else {
          syncGuard = false;
        }
      });
    }
  }

  function renderTick() {
    drawCanvasFrame();
    renderDocPiP();
    if ('mediaSession' in navigator && S.activeTimer) {
      setupMediaSessionHandlers();
    }
  }

  function close() {
    if (docPipWin && !docPipWin.closed) docPipWin.close();
    if (document.pictureInPictureElement) document.exitPictureInPicture().catch(() => {});
  }

  return { togglePiP, syncState, renderTick, close };
})();

/* ==========================================================================
   7. HABIT & GAMIFICATION CORE LOGIC
   ========================================================================== */
const ent = (h, k) => S.log[h.id]?.[k];
const done = (h, k) => { const e = ent(h, k); return !!e && !e.s && e.v >= h.tn; };
const skip = (h, k) => !!ent(h, k)?.s;
const live = () => S.habits.filter(h => !h.arch);
const wkS = k => addD(k, -((parse(k).getDay() - S.set.ws + 7) % 7));
const wkC = (h, k) => {
  const s = wkS(k);
  let c = 0;
  for (let i = 0; i < 7; i++) if (done(h, addD(s, i))) c++;
  return c;
};
const due = (h, k) => h.sch === 'days' ? h.days.includes(parse(k).getDay()) : h.sch === 'week' ? done(h, k) || wkC(h, k) < h.n : true;
const dueOn = k => live().filter(h => due(h, k));

function streak(h) {
  const t = today();
  let run = 0, best = 0;
  if (h.sch !== 'week') {
    for (let k = h.created; k <= t; k = addD(k, 1)) {
      if (h.sch === 'days' && !h.days.includes(parse(k).getDay())) continue;
      if (done(h, k)) run++;
      else if (!skip(h, k) && k !== t) run = 0;
      best = Math.max(best, run);
    }
  } else {
    for (let k = wkS(h.created); k <= t; k = addD(k, 7)) {
      const c = wkC(h, k);
      if (c >= h.n) run++;
      else if (addD(k, 7) <= t) run = 0;
      best = Math.max(best, run);
    }
  }
  return { cur: run, best };
}

const pct = k => {
  const a = dueOn(k);
  return a.length ? a.filter(h => done(h, k)).length / a.length : 0;
};

function rate(h, n) {
  let d = 0, c = 0;
  for (let i = 0; i < n; i++) {
    const k = addD(today(), -i);
    if (k < h.created || (h.sch === 'days' && !h.days.includes(parse(k).getDay()))) continue;
    if (skip(h, k)) continue;
    d++;
    if (done(h, k)) c++;
  }
  return d ? Math.round(c / d * 100) : 0;
}

const total = h => Object.keys(S.log[h.id] || {}).filter(k => done(h, k)).length;
function xp() {
  let x = S.bonus || 0;
  S.habits.forEach(h => { x += total(h) * 20 + streak(h).best * 5; });
  return x;
}
const lvl = x => Math.floor(Math.sqrt(x / 60)) + 1;

function badges() {
  const hs = S.habits, all = hs.reduce((a, h) => a + total(h), 0), bs = Math.max(0, ...hs.map(h => streak(h).best));
  const totalStudyHrs = S.sessions.reduce((a, s) => a + (s.activeMs || 0), 0) / 3600000;
  let perf = 0;
  for (let i = 0; i < 60; i++) if (dueOn(addD(today(), -i)).length >= 2 && pct(addD(today(), -i)) === 1) perf++;
  return [
    ['🌱 First check-in', all >= 1],
    ['🔥 7-day streak', bs >= 7],
    ['🏔️ 30-day streak', bs >= 30],
    ['🎧 10h studied', totalStudyHrs >= 10],
    ['🎓 50h studied', totalStudyHrs >= 50],
    ['⭐ Perfect day', perf >= 1],
    ['💯 100 check-ins', all >= 100]
  ];
}

function toast(m, fn) {
  const t = $('#toast');
  t.innerHTML = `<span>${esc(m)}</span>`;
  if (fn) {
    const b = document.createElement('button');
    b.textContent = 'Undo';
    b.onclick = () => { fn(); t.style.display = 'none'; };
    t.append(b);
  }
  t.style.display = 'flex';
  clearTimeout(t._t);
  t._t = setTimeout(() => t.style.display = 'none', 4500);
}

const snap = () => JSON.stringify(S);
const undo = j => () => { S = norm(JSON.parse(j)); save(); theme(); R(); };

function boom() {
  if (matchMedia('(prefers-reduced-motion:reduce)').matches) return;
  for (let i = 0; i < 28; i++) {
    const e = document.createElement('i');
    e.className = 'cf';
