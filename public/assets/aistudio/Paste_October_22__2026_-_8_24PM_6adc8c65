/* ==========================================================================
   10. CLOUD SYNC (SUPABASE) & EXPORT / IMPORT
   ========================================================================== */
const CF = window.PH_CONFIG || {};
let sb = null, user = null, sy = { msg: '', busy: 0, t: 0 };

function initSync() {
  if (!CF.SUPABASE_URL || !CF.SUPABASE_ANON_KEY || !window.supabase) return;
  sb = supabase.createClient(CF.SUPABASE_URL, CF.SUPABASE_ANON_KEY);
  sb.auth.onAuthStateChange((_, s) => { user = s?.user || null; user ? sync() : R(); });
}

function merge(a, b) {
  const m = norm(JSON.parse(JSON.stringify(b))), D = new Set([...(a.del || []), ...(m.del || [])]);
  m.del = [...D];
  a.habits.forEach(h => { if (!m.habits.some(x => x.id === h.id)) m.habits.push(h); });
  m.habits = m.habits.filter(h => !D.has(h.id)).map(r => {
    const l = a.habits.find(x => x.id === r.id);
    return l && (l.u || 0) > (r.u || 0) ? l : r;
  });
  (a.subjects || []).forEach(s => { if (!m.subjects.some(x => x.id === s.id)) m.subjects.push(s); });
  (a.sessions || []).forEach(s => { if (!m.sessions.some(x => x.id === s.id)) m.sessions.push(s); });
  for (const id in a.log) {
    if (D.has(id)) continue;
    const L = m.log[id] ??= {};
    for (const k in a.log[id]) {
      const x = a.log[id][k], y = L[k];
      if (!y || x.v >= y.v) L[k] = x;
    }
  }
  return m;
}

async function sync() {
  if (!sb || !user || sy.busy) return;
  sy.busy = 1; sy.msg = 'Syncing…';
  try {
    const { data, error } = await sb.from('user_state').select('data').eq('user_id', user.id).maybeSingle();
    if (error) throw error;
    if (data?.data) S = merge(S, data.data);
    const r = await sb.from('user_state').upsert({ user_id: user.id, data: S, updated_at: new Date().toISOString() });
    if (r.error) throw r.error;
    sy.msg = 'Synced ' + new Date().toLocaleTimeString();
    try { await kv('put', 's', S); } catch {}
  } catch {
    sy.msg = 'Offline · local storage active';
  }
  sy.busy = 0; theme(); R();
}

function syncCard() {
  if (!CF.SUPABASE_URL) return '';
  return `<h2>Cloud Sync</h2><div class="card" style="display:grid;gap:8px">${user
    ? `<small>Signed in as ${esc(user.email)}<br>${esc(sy.msg)}</small><div class="row"><button class="g" data-a="sync">Sync now</button><button class="g" data-a="logout">Sign out</button></div>`
    : `<small>Sign in with email for cloud backup.</small><input id="em" type="email" placeholder="you@email.com"><button class="pri" data-a="login">Send Magic Link</button>`}</div>`;
}

function dl(name, txt, type) {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([txt], { type }));
  a.download = name;
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 1e3);
}

const clean = j => {
  if (!j || !Array.isArray(j.habits)) throw 0;
  return norm(j);
};

async function notify(t, b) {
  try {
    const r = await navigator.serviceWorker?.getRegistration();
    r ? r.showNotification(t, { body: b, icon: 'icon.svg', tag: 'ph' }) : new Notification(t, { body: b });
  } catch {}
}

