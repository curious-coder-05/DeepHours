function tickTimerLoop() {
  const t = S?.activeTimer;
  if (!t) {
    clearInterval(timerLoopId);
    timerLoopId = 0;
    return;
  }

  const m = getTimerMetrics();
  // Priority 2.2: Count-Up Overtime chime when crossing 00:00
  if (t.status === 'running' && t.mode !== 'stopwatch' && m.overtimeMs > 0 && !t.chimeFired) {
    t.chimeFired = true;
