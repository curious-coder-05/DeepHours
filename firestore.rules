rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidCollection(collectionName) {
      return collectionName in ['meta', 'months'];
    }

    function isValidDocId(docId) {
      return docId is string && docId.size() >= 1 && docId.size() <= 128;
    }

    match /users/{userId}/{collectionName}/{docId} {
      allow read: if isOwner(userId)
        && isValidCollection(collectionName);

      allow create, update: if isOwner(userId)
        && isValidCollection(collectionName)
        && isValidDocId(docId)
        && request.resource.data is map
        && request.resource.data.updatedAt is number
        && request.resource.data.updatedAt > 0
        && request.resource.data.size() <= 50;

      allow delete: if isOwner(userId)
        && isValidCollection(collectionName)
        && isValidDocId(docId);
    }
  }
}

